{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "*.ts",
    "src/features/boards/board.routes.ts",
    "src/features/columns/column.service.ts",
    "src/features/tasks/task.routes.ts",
    "src/features/tasks/task.service.ts",
    "src/middleware/errors.ts",
    "src/utils/utils.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}